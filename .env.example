# Copy this file to .env and fill in ONE key. .env is git-ignored.
# Optional: without a key the app uses the rule-based fallback.

# Anthropic Claude (paid credit needed)
ANTHROPIC_API_KEY=

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: force a provider when both keys are set (anthropic | gemini)
# FIQ_PROVIDER=gemini

# Optional: override the models
# FIQ_MODEL=claude-opus-5-5
# FIQ_GEMINI_MODEL=gemini-3.8-flash

# Optional: most reviews sent to the LLM per analysis (cost guard, default 500)
# FIQ_MAX_LLM_REVIEWS=500
